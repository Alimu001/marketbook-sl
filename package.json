{
  "name": "marketbook-sl",
  "private": true,
  "type": "module",
  "workspaces": [
    "mobile",
    "server",
    "packages/*"
  ],
  "scripts": {
    "dev:server": "npm run dev -w server",
    "dev:mobile": "npm run start -w mobile",
    "dev": "concurrently -n server,mobile -c blue,green \"npm run dev:server\" \"npm run dev:mobile\"",
    "start:server": "npm run start -w server",
    "start:mobile": "npm run start -w mobile",
    "db:migrate": "npm run db:migrate -w server",
    "db:seed": "npm run db:seed -w server",
    "db:studio": "npm run db:studio -w server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test -w server"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "concurrently": "^9.1.2",
    "eslint": "^9.39.2",
    "typescript-eslint": "^8.50.0"
  }
}
