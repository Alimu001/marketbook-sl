# Root-level environment conventions for MarketBook SL.
# Copy package-specific examples instead of using this file directly:
#
#   server/.env.example  →  server/.env
#   mobile/.env.example  →  mobile/.env
#
# Never commit real secrets. All .env files are gitignored.
# Optional absolute directory for verified PostgreSQL backups.
BACKUP_DIRECTORY=
# Optional PostgreSQL client-tools bin directory when not available on PATH.
POSTGRES_BIN=
