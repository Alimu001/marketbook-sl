NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/marketbook_sl

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:8081
JSON_BODY_LIMIT=100kb
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
# Set to the number of trusted reverse proxies in production; keep 0 locally.
TRUST_PROXY_HOPS=0
# Logs only request ID, method, path, status, and duration. Never request bodies.
REQUEST_LOGGING_ENABLED=true

# Payment providers (never commit real secrets)
PAYMENT_MOCK_ENABLED=true
PAYMENT_EXPIRY_MINUTES=15

# Orange Money Web Payment / M Payment (Sierra Leone)
ORANGE_MONEY_ENABLED=false
ORANGE_MONEY_BASE_URL=
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_MERCHANT_KEY=
ORANGE_MONEY_COUNTRY_PATH=dev
ORANGE_MONEY_CURRENCY=OUV
ORANGE_MONEY_RETURN_URL=
ORANGE_MONEY_CANCEL_URL=
ORANGE_MONEY_CALLBACK_URL=
ORANGE_MONEY_LANG=en
