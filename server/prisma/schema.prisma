generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BusinessRole {
  owner
  admin
  staff
  cashier
}

enum InventoryTransactionType {
  OPENING_STOCK
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  DAMAGE
  RETURN_IN
  SALE
}

enum SaleStatus {
  COMPLETED
  VOIDED
}

enum PaymentMethod {
  CASH
  MOBILE_MONEY
  BANK_TRANSFER
}

enum SalePaymentStatus {
  PAID
  PARTIALLY_PAID
  UNPAID
}

enum DebtStatus {
  OPEN
  PARTIALLY_PAID
  PAID
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  businessMembers BusinessMember[]
  refreshTokens   RefreshToken[]
  inventoryTransactions InventoryTransaction[] @relation("InventoryPerformedBy")
  salesCreated          Sale[]                 @relation("SaleCreatedBy")
  debtPaymentsRecorded  DebtPayment[]          @relation("DebtPaymentRecordedBy")

  @@index([email])
}

model Business {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  BusinessMember[]
  products Product[]
  inventoryBalances     InventoryBalance[]
  inventoryTransactions InventoryTransaction[]
  sales                 Sale[]
  saleReceiptSequences  SaleReceiptSequence[]
  customers             Customer[]
  customerDebts         CustomerDebt[]
  debtPayments          DebtPayment[]

  @@index([name])
}

model BusinessMember {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String       @db.Uuid
  businessId String       @db.Uuid
  role       BusinessRole
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@index([businessId])
  @@index([userId])
  @@index([role])
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Product {
  id           String   @id @default(uuid()) @db.Uuid
  businessId   String   @db.Uuid
  name         String
  description  String?
  sku          String?
  barcode      String?
  category     String?
  unit         String
  costPrice    Decimal  @db.Decimal(19, 4)
  sellingPrice Decimal  @db.Decimal(19, 4)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  inventoryBalance     InventoryBalance?
  inventoryTransactions InventoryTransaction[]
  saleItems            SaleItem[]

  @@unique([businessId, sku])
  @@unique([businessId, barcode])
  @@index([businessId])
  @@index([businessId, name])
  @@index([businessId, isActive])
}

model InventoryBalance {
  id                String   @id @default(uuid()) @db.Uuid
  businessId        String   @db.Uuid
  productId         String   @unique @db.Uuid
  quantity          Decimal  @default(0) @db.Decimal(19, 4)
  lowStockThreshold Decimal  @default(0) @db.Decimal(19, 4)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([businessId, productId])
  @@index([businessId])
  @@index([productId])
  @@index([businessId, productId])
}

model InventoryTransaction {
  id                String                   @id @default(uuid()) @db.Uuid
  businessId        String                   @db.Uuid
  productId         String                   @db.Uuid
  performedByUserId String                   @db.Uuid
  type              InventoryTransactionType
  quantityChange    Decimal                  @db.Decimal(19, 4)
  quantityBefore    Decimal                  @db.Decimal(19, 4)
  quantityAfter     Decimal                  @db.Decimal(19, 4)
  reason            String?
  referenceType     String?
  referenceId       String?                  @db.Uuid
  notes             String?
  createdAt         DateTime                 @default(now())

  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  performedBy User     @relation("InventoryPerformedBy", fields: [performedByUserId], references: [id], onDelete: Restrict)

  @@index([businessId])
  @@index([productId])
  @@index([createdAt])
  @@index([businessId, productId])
  @@index([type])
}

model Sale {
  id                  String             @id @default(uuid()) @db.Uuid
  businessId          String             @db.Uuid
  createdByUserId     String             @db.Uuid
  customerId          String?            @db.Uuid
  customerNameSnapshot String?
  receiptNumber       String             @unique
  subtotal            Decimal            @db.Decimal(19, 4)
  discountAmount      Decimal            @default(0) @db.Decimal(19, 4)
  totalAmount         Decimal            @db.Decimal(19, 4)
  amountPaid          Decimal            @default(0) @db.Decimal(19, 4)
  outstandingAmount   Decimal            @default(0) @db.Decimal(19, 4)
  paymentMethod       PaymentMethod?
  paymentStatus       SalePaymentStatus  @default(PAID)
  status              SaleStatus         @default(COMPLETED)
  notes               String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  business  Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdBy User          @relation("SaleCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  customer  Customer?     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items     SaleItem[]
  debt      CustomerDebt?

  @@index([businessId])
  @@index([businessId, createdAt])
  @@index([paymentMethod])
  @@index([paymentStatus])
  @@index([createdByUserId])
  @@index([customerId])
}

model SaleItem {
  id                  String   @id @default(uuid()) @db.Uuid
  saleId              String   @db.Uuid
  productId           String   @db.Uuid
  productNameSnapshot String
  skuSnapshot         String?
  unitSnapshot        String
  quantity            Decimal  @db.Decimal(19, 4)
  unitPrice           Decimal  @db.Decimal(19, 4)
  costPriceSnapshot   Decimal  @db.Decimal(19, 4)
  lineSubtotal        Decimal  @db.Decimal(19, 4)
  createdAt           DateTime @default(now())

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([productId])
}

model SaleReceiptSequence {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @db.Uuid
  dateKey    String
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, dateKey])
  @@index([businessId])
}

model Customer {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @db.Uuid
  name       String
  phone      String?
  email      String?
  address    String?
  notes      String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business     Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sales        Sale[]
  debts        CustomerDebt[]
  debtPayments DebtPayment[]

  @@index([businessId])
  @@index([businessId, name])
  @@index([businessId, phone])
  @@index([businessId, email])
  @@index([businessId, isActive])
}

model CustomerDebt {
  id                String     @id @default(uuid()) @db.Uuid
  businessId        String     @db.Uuid
  customerId        String     @db.Uuid
  saleId            String     @unique @db.Uuid
  originalAmount    Decimal    @db.Decimal(19, 4)
  amountPaid        Decimal    @default(0) @db.Decimal(19, 4)
  outstandingAmount Decimal    @db.Decimal(19, 4)
  status            DebtStatus @default(OPEN)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  business Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  sale     Sale          @relation(fields: [saleId], references: [id], onDelete: Restrict)
  payments DebtPayment[]

  @@index([businessId])
  @@index([customerId])
  @@index([businessId, status])
  @@index([createdAt])
}

model DebtPayment {
  id               String        @id @default(uuid()) @db.Uuid
  businessId       String        @db.Uuid
  customerId       String        @db.Uuid
  debtId           String        @db.Uuid
  amount           Decimal       @db.Decimal(19, 4)
  paymentMethod    PaymentMethod
  recordedByUserId String        @db.Uuid
  balanceBefore    Decimal       @db.Decimal(19, 4)
  balanceAfter     Decimal       @db.Decimal(19, 4)
  notes            String?
  createdAt        DateTime      @default(now())

  business   Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer   Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  debt       CustomerDebt @relation(fields: [debtId], references: [id], onDelete: Restrict)
  recordedBy User         @relation("DebtPaymentRecordedBy", fields: [recordedByUserId], references: [id], onDelete: Restrict)

  @@index([businessId])
  @@index([customerId])
  @@index([debtId])
  @@index([createdAt])
}
